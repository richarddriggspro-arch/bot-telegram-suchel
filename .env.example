# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env real a GitHub (ya esta en .gitignore).

# Token que te da BotFather al crear el bot (OBLIGATORIO)
BOT_TOKEN=123456789:ABCdEfGhIjKlMnOpQrStUvWxYz

# URL de la tienda online
TIENDA_URL=https://tienda.suchelproquimia.com/

# (Opcional) Chat o grupo donde quieres recibir las consultas de los clientes.
# Para saber tu ID: escribele a @userinfobot en Telegram.
ADMIN_CHAT_ID=

# (Opcional) Texto de contacto que ve el cliente en "Atencion al cliente".
CONTACTO_TEXTO=Escribenos aqui mismo tu consulta y un asesor te respondera lo antes posible.
